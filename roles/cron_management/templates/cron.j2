# Managed by Ansible
{% if cron_management_mail_from is not none %}
MAILFROM={{ cron_management_mail_from }}
{% endif %}
{% if cron_management_mail_to is not none %}
MAILTO={{ cron_management_mail_to }}
{% endif %}
{% for item in cron_management_jobs | default([], true) %}
#Ansible: {{ item.name }}
{% if item.special_time is defined %}
@{{ item.special_time }} {{ item.user | default(cron_management_default_user) }} {{ item.job | replace('%', '\\%') }}
{% else %}
{{ item.minute | default('*') }} {{ item.hour | default('*') }} {{ item.day | default('*') }} {{ item.month | default('*') }} {{ item.weekday | default('*') }} {{ item.user | default(cron_management_default_user) }} {{ item.job | replace('%', '\\%') }}
{% endif %}
{% endfor %}
