# Generated by Ansible, manual changes will be overwritten.
[Unit]
Description=Nagflux - ships Nagios performance data to InfluxDB
Documentation=https://github.com/ConSol-Monitoring/nagflux
After=network-online.target nagios.service
Wants=network-online.target

[Service]
User=nagios
Group=nagios
WorkingDirectory=/var/lib/nagflux
ExecStart=/opt/nagflux/nagflux -configPath /opt/nagflux/config.gcfg
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
