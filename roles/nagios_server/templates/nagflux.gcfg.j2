# Generated by Ansible, manual changes will be overwritten.
[main]
    NagiosSpoolfileFolder = "/usr/local/nagios/var/spool/nagfluxperfdata"
    NagiosSpoolfileWorker = 1
    InfluxWorker = 2
    MaxInfluxWorker = 5
    DumpFile = "/var/lib/nagflux/nagflux.dump"
    NagfluxSpoolfileFolder = "/var/lib/nagflux/spool"
    FieldSeparator = "&"
    BufferSize = 10000
    FileBufferSize = 65536
    DefaultTarget = "all"

[Log]
    # Empty logs to stdout, which systemd sends to the journal.
    LogFile = ""
    MinSeverity = "INFO"

[Monitoring]
    PrometheusAddress = ""

[Livestatus]
    Enabled = false

[NagiosSpoolfile]
    Enabled = true
    Folder = "/usr/local/nagios/var/spool/nagfluxperfdata"
    WorkerCount = 1

[NagfluxSpoolfile]
    Enabled = true
    Folder = "/var/lib/nagflux/spool"

[InfluxDBGlobal]
    CreateDatabaseIfNotExists = true
    NastyString = ""
    NastyStringToReplace = ""
    HostcheckAlias = "hostcheck"
    ClientTimeout = 5

[InfluxDB "nagflux"]
    Enabled = true
    Version = 1.0
    Address = "{{ nagios_server_nagflux_influxdb_url }}"
    Arguments = "precision=ms&db={{ nagios_server_nagflux_influxdb_database }}"
    StopPullingDataIfDown = true
